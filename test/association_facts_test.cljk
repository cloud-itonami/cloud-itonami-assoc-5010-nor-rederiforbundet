(ns association-facts-test
  (:require [clojure.java.io :as io] [clojure.java.shell :as shell]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.compiler.core :as compiler] [kotoba.kir :as ir]))
(def source (slurp "src/association_facts.kotoba"))
(defn call [kir function & args] (ir/execute kir function (vec args)))
(defn present [option] (when (second option) (nth option 2)))
(def fields ["id" "title" "association" "isic" "country" "kind" "url"
             "url-provenance" "established-date" "retrieved-at"])
(def expected
  [{"id" "rederiforbundet.founding-1909" "title" "Norges Rederiforbund founding (Vår historie)"
    "association" "rederiforbundet" "isic" "5010" "country" "NOR" "kind" "governance-program"
    "url" "https://www.rederi.no/om-oss/historie/" "url-provenance" "official-rederi-no"
    "established-date" "1909-09-15" "retrieved-at" "2026-07-16"}
   {"id" "rederiforbundet.thor-heyerdahl-award-1999"
    "title" "Thor Heyerdahl International Maritime Award (About us)"
    "association" "rederiforbundet" "isic" "5010" "country" "NOR" "kind" "governance-program"
    "url" "https://www.rederi.no/en/about-us/" "url-provenance" "official-rederi-no"
    "established-date" "1999" "retrieved-at" "2026-07-16"}])

(deftest reference-preserves-fields-date-precision-and-topics
  (let [kir (:kir (compiler/compile-source source :js-kotoba-v1))
        observed (mapv (fn [i] (into {} (map (fn [f] [f (present (call kir 'entry-field "rederiforbundet" i f))]) fields))) [0 1])]
    (is (= expected observed))
    (is (= ["1909-09-15" "1999"] (mapv #(present (call kir 'entry-field "rederiforbundet" % "established-date")) [0 1])))
    (is (= ["governance" "environment"] (mapv #(present (call kir 'topic "rederiforbundet" % 0)) [0 1])))
    (is (= "rederiforbundet.thor-heyerdahl-award-1999" (present (call kir 'by-topic-id "rederiforbundet" "environment" 0))))
    (is (= #{} (set (:effects kir))))
    (testing "unknown values and invalid indexes fail closed"
      (is (zero? (call kir 'entry-count "aba")))
      (is (nil? (present (call kir 'entry-field "rederiforbundet" -1 "id"))))
      (is (nil? (present (call kir 'entry-field "rederiforbundet" 2 "id"))))
      (is (nil? (present (call kir 'entry-field "rederiforbundet" 0 "unknown"))))
      (is (nil? (present (call kir 'topic "rederiforbundet" 0 1))))
      (is (zero? (call kir 'by-topic-count "rederiforbundet" "labor")))
      (is (nil? (present (call kir 'by-topic-id "rederiforbundet" "environment" 1)))))))

(defn compiler-root []
  (nth (iterate #(.getParent ^java.nio.file.Path %)
                (java.nio.file.Path/of (.toURI (io/resource "kotoba/compiler/core.clj")))) 4))
(defn base64 [value] (.encodeToString (java.util.Base64/getEncoder) value))
(deftest restricted-javascript-and-typed-wasm-conform-semantically
  (let [javascript (compiler/compile-source source :js-kotoba-v1)
        wasm (compiler/compile-source source :wasm32-browser-kotoba-v1)
        js64 (base64 (.getBytes ^String (:source javascript) "UTF-8")) wasm64 (base64 ^bytes (:bytes wasm))
        probe (shell/sh "node" "--input-type=module" "-e"
                (str "import(process.argv[1]).then(async host=>{const j=await import('data:text/javascript;base64," js64 "');"
                     "const w=await host.instantiateKotoba(Buffer.from(process.argv[2],'base64'));const run=x=>{"
                     "if(x['entry-count']('rederiforbundet')!==2n||x['entry-field']('rederiforbundet',0n,'established-date')[2]!=='1909-09-15'||x['entry-field']('rederiforbundet',1n,'established-date')[2]!=='1999')throw Error('dates');"
                     "if(x['topic']('rederiforbundet',0n,0n)[2]!=='governance'||x['topic']('rederiforbundet',1n,0n)[2]!=='environment')throw Error('topics');"
                     "if(x['by-topic-id']('rederiforbundet','environment',0n)[2]!=='rederiforbundet.thor-heyerdahl-award-1999'||x['topic']('rederiforbundet',0n,1n)[1]!==false)throw Error('query');};"
                     "run(j.instantiateKotoba({}));run(w.instance.exports);}).catch(e=>{console.error(e);process.exit(99)})")
                (.toString (.toUri (.resolve (compiler-root) "runtime/browser-host.mjs"))) wasm64)]
    (is (zero? (:exit probe)) (str (:out probe) (:err probe)))))
(deftest production-source-authority
  (is (= ["src/association_facts.kotoba"]
         (->> (file-seq (io/file "src")) (filter #(.isFile %)) (map str) sort vec))))
